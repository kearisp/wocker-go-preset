{
    "name": "go",
    "version": "1.0.1",
    "dockerfile": "./Dockerfile",
    "DocumentRoot": "/usr/app",
    "envOptions": {
        "IMAGE_VERSION": {
            "type": "text",
            "required": true,
            "default": "latest"
        },
        "GO_RUN": {
            "type": "text",
            "required": true,
            "default": "go run main.go"
        }
    },
    "volumeOptions": [
        "./:/usr/app"
    ]
}
